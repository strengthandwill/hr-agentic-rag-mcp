# Copy this file to .env and fill in your own values. Never commit .env.

# Required: free API key from https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# Optional overrides (defaults shown)
GROQ_MODEL=openai/gpt-oss-120b
EMBEDDING_MODEL_NAME=default
CHROMA_PERSIST_DIR=data/chroma
CORPUS_DIR=corpus
MOCK_DATA_DIR=mock_data
RETRIEVAL_TOP_K=5
AGENT_MAX_TOOL_ITERATIONS=6
MCP_SERVER_CMD=python -m mcp_server.server
PORT=8000
